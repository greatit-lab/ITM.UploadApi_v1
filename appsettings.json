{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    // [중요] 윈도우 경로(D:\\...)를 리눅스 절대 경로로 변경
    "SavePath": "/appdata/object_store",
    "AllowedExtensions": ".pdf,.jpg,.png,.txt"
  }
}
